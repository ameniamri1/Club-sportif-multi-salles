<mxCell id="legende" value="&lt;b&gt;Lecture&lt;/b&gt;&lt;br/&gt;Identifiants soulignés. Les cardinalités sont placées du côté de l’entité concernée.&lt;br/&gt;0,N : zéro à plusieurs · 1,1 : exactement un · 0,1 : facultatif, au maximum un." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="220" y="1060" width="1300" height="90" as="geometry"/></mxCell>
<mxCell id="regles" value="&lt;b&gt;Règles à retenir&lt;/b&gt;&lt;br/&gt;RG13 : cours existant, montant ≥ 0 et réservation au plus tard au début du cours.&lt;br/&gt;RG20 : une sur-réservation ne rend pas une opération invalide.&lt;br/&gt;RG21 et RG25 : parrainage facultatif, sans auto-parrainage ; aucune donnée source ne le renseigne." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="220" y="1160" width="1300" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram>
