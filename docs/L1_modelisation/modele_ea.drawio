<mxCell id="notes" value="&lt;b&gt;Conservation des lignes&lt;/b&gt;&lt;br/&gt;La clé composée id_lot + numero_ligne identifie un enregistrement dans chaque table brute.&lt;br/&gt;Les champs sources restent textuels. Les références aux cours absents, les montants négatifs et les dates incorrectes sont conservés.&lt;br/&gt;Aucune relation métier obligatoire ne relie les tables brutes entre elles." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="80" y="1110" width="1700" height="100" as="geometry"/></mxCell>
<mxCell id="rapprochement" value="&lt;b&gt;RG15 et RG16 — Personnes&lt;/b&gt;&lt;br/&gt;Même email normalisé : une même personne. Ligne sans email : une personne distincte.&lt;br/&gt;Une ligne brute peut rester sans correspondance tant qu’elle n’est pas traitée. Une personne peut être reliée à plusieurs lignes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="80" y="1230" width="1700" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
